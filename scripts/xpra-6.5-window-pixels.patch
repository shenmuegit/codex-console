+    def get_image(self, x: int, y: int, width: int, height: int):
+        from xpra.x11.bindings.core import get_root_xid
+        if self.xid == get_root_xid():
+            return super().get_image(x, y, width, height)
+        # A selected window needs its own pixels, not the desktop below its
+        # rectangle. The latter includes other apps and the screen locker.
+        from xpra.x11.bindings.composite import XCompositeBindings
+        from xpra.x11.bindings.ximage import XImageBindings
+        from xpra.x11.error import xsync
+        composite = XCompositeBindings()
+        handle = None
+        try:
+            with xsync:
+                if not self.window_redirected:
+                    composite.XCompositeRedirectWindow(self.xid)
+                    self.window_redirected = True
+                handle = XImageBindings().wrap_pixmap(composite.XCompositeNameWindowPixmap(self.xid))
+                if handle is None:
+                    return None
+                return handle.get_image(x, y, width, height)
+        except Exception:
+            # Never fall back to root capture when this window disappears.
+            log("selected-window capture failed", exc_info=True)
+            return None
+        finally:
+            if handle is not None:
+                handle.cleanup()
+
+    def unmanage(self, exiting=False) -> None:
+        if self.window_redirected:
+            from xpra.x11.bindings.composite import XCompositeBindings
+            from xpra.x11.error import xlog
+            self.window_redirected = False
+            with xlog:
+                XCompositeBindings().XCompositeUnredirectWindow(self.xid)
+
